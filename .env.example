# Credenciales de Matba Rofex (ReMarkets / produccion).
# Copia este archivo a ".env" y completa los valores reales.
# El archivo ".env" esta gitignored: NUNCA se commitea.

ROFEX_USER=tu_usuario
ROFEX_PASSWORD=tu_password
ROFEX_ACCOUNT=tu_cuenta

# Entorno: REMARKET (pruebas/homologacion) o LIVE (produccion).
# Dejar en REMARKET hasta que el broker habilite las credenciales productivas.
ROFEX_ENV=REMARKET
