//@version=6
// GGAL Señales — paper trading intradiario sobre el ADR de GGAL.
//
// Marca en el chart lo que haria con plata real: LONG o SHORT, posicion grande o
// chica, stop, objetivo y R:R. No opera nada: es una estrategia de TradingView
// para ver las señales en vivo, dispararlas como alertas y medirlas en el
// Strategy Tester.
//
// Reglas:
//   - Tendencia diaria = cierre de ayer contra la EMA20 diaria de ayer.
//   - Setup: en 15m, EMA9 del lado de la EMA21, precio del lado del VWAP,
//     retroceso que toco la EMA21 en las ultimas 3 velas, y vela que CIERRA
//     rompiendo la vela anterior. Todo al cierre de vela: no repinta.
//   - Stop: extremo de las ultimas 5 velas, con un colchon de 0,1 ATR.
//   - Objetivo: el primer nivel (maximo/minimo de ayer, de hoy o ultimo pivote)
//     entre 1,5R y 4R; sin niveles a la vista, 2R. Si el maximo/minimo de AYER
//     esta antes de 1,5R, no entra: el camino esta tapado.
//   - Grande (1% de riesgo): la señal va CONTRA la tendencia diaria, o sea el
//     intradia esta girando. Chica (0,5%): va a favor.
//   - Una posicion por vez, maximo 3 por dia, entradas 9:45-15:30 NY, y todo
//     cerrado en la ultima vela (15:45 NY). Nada queda abierto de un dia para el otro.
//
// Por que grande es contra la tendencia (backtest 15m, dic-2025 a sep-2026, 97
// operaciones): a favor de la tendencia diaria el setup dio PF 0,71 y en contra
// PF 1,68, y la diferencia se sostuvo en las dos mitades (dic-abr 0,65 vs 1,42;
// may-sep 0,85 vs 2,55). Es lo contrario de lo que mostro la auditoria de los
// estudios diarios: en 15m, la continuacion contra la tendencia del diario marca
// los dias de giro. Resultado con estas reglas: 44% de aciertos, PF 1,27, +7,8%,
// drawdown maximo 7%. Muestra chica: medirlo en vivo antes de creerle.

strategy("GGAL Señales", shorttitle = "GGAL Señal", overlay = true,
     initial_capital = 100000, currency = currency.USD,
     commission_type = strategy.commission.cash_per_order, commission_value = 1,
     slippage = 1, pyramiding = 0,
     // Poder de compra intradia 4x (cuenta de day trading en EE.UU.). Con el
     // margen por defecto (100%) las posiciones grandes con stop corto piden mas
     // que el capital y TradingView rechaza la orden sin avisar.
     margin_long = 25, margin_short = 25,
     max_labels_count = 500, max_lines_count = 500)

// --- Parametros ----------------------------------------------------------------
emaRapLen    = input.int(9, "EMA rapida")
emaLenLen    = input.int(21, "EMA lenta")
atrLen       = input.int(14, "ATR")
rrMin        = input.float(1.5, "R:R minimo para operar", step = 0.1)
rrMax        = input.float(4.0, "R:R maximo del objetivo", step = 0.1)
riesgoGrande = input.float(1.0, "Riesgo posicion grande (% del capital)", step = 0.1)
riesgoChica  = input.float(0.5, "Riesgo posicion chica (% del capital)", step = 0.1)
maxOps       = input.int(3, "Maximo de operaciones por dia")
ventana      = input.session("0945-1530", "Ventana de entradas (hora NY)")
cierreSes    = input.session("1545-1600", "Cierre forzado: velas que arrancan en esta franja (hora NY)")

// --- Contexto diario (dia anterior: no repinta) --------------------------------
[dCierre, dEma, pdh, pdl] = request.security(syminfo.tickerid, "D",
     [close[1], ta.ema(close, 20)[1], high[1], low[1]], lookahead = barmerge.lookahead_on)
tendAlcista = dCierre > dEma
tendBajista = dCierre < dEma

// --- Intradiario ------------------------------------------------------------------
emaR   = ta.ema(close, emaRapLen)
emaL   = ta.ema(close, emaLenLen)
vwap   = ta.vwap(hlc3)
atr    = ta.atr(atrLen)

enVentana = not na(time(timeframe.period, ventana, "America/New_York"))
enCierre  = not na(time(timeframe.period, cierreSes, "America/New_York"))
nuevoDia  = timeframe.change("D")

// Maximo y minimo de la sesion hasta la vela anterior.
var float hoyMax = na
var float hoyMin = na
var int opsHoy = 0
float hoyMaxPrev = nuevoDia ? na : hoyMax
float hoyMinPrev = nuevoDia ? na : hoyMin
if nuevoDia
    hoyMax := high
    hoyMin := low
    opsHoy := 0
else
    hoyMax := math.max(hoyMax, high)
    hoyMin := math.min(hoyMin, low)

// Ultimos pivotes confirmados (5 velas a cada lado).
var float ultPH = na
var float ultPL = na
ph = ta.pivothigh(high, 5, 5)
pl = ta.pivotlow(low, 5, 5)
if not na(ph)
    ultPH := ph
if not na(pl)
    ultPL := pl

// --- Objetivo y camino ------------------------------------------------------------
// Devuelve el objetivo, o na si un nivel DIARIO tapa el camino antes de rrMin.
// Los niveles intradia (maximo/minimo de hoy, ultimo pivote) no bloquean: en un
// retroceso a favor de la tendencia el extremo del dia siempre esta cerca, y
// romperlo es justamente la continuacion. Solo cuentan como objetivo.
f_objetivo(float entrada, float riesgo, bool esLong, array<float> bloqueantes, array<float> objetivos) =>
    bool tapado = false
    for n in bloqueantes
        if not na(n)
            float dist = esLong ? n - entrada : entrada - n
            if dist > 0 and dist < rrMin * riesgo
                tapado := true
    float obj = na
    for n in objetivos
        if not na(n)
            float dist = esLong ? n - entrada : entrada - n
            if dist >= rrMin * riesgo and dist <= rrMax * riesgo
                obj := na(obj) ? n : esLong ? math.min(obj, n) : math.max(obj, n)
    tapado ? na : na(obj) ? (esLong ? entrada + 2 * riesgo : entrada - 2 * riesgo) : obj

// --- Setups -----------------------------------------------------------------------
tocoL = low <= emaL or low[1] <= emaL[1] or low[2] <= emaL[2]
tocoS = high >= emaL or high[1] >= emaL[1] or high[2] >= emaL[2]
setupL = emaR > emaL and close > vwap and close > emaR and tocoL and close > high[1]
setupS = emaR < emaL and close < vwap and close < emaR and tocoS and close < low[1]

slL = ta.lowest(low, 5) - 0.1 * atr
slS = ta.highest(high, 5) + 0.1 * atr
riesgoL = close - slL
riesgoS = slS - close
riesgoOkL = riesgoL >= 0.4 * atr and riesgoL <= 3 * atr
riesgoOkS = riesgoS >= 0.4 * atr and riesgoS <= 3 * atr

tpL = riesgoOkL ? f_objetivo(close, riesgoL, true, array.from(pdh), array.from(pdh, hoyMaxPrev, ultPH)) : na
tpS = riesgoOkS ? f_objetivo(close, riesgoS, false, array.from(pdl), array.from(pdl, hoyMinPrev, ultPL)) : na
rrL = riesgoL > 0 ? (tpL - close) / riesgoL : na
rrS = riesgoS > 0 ? (close - tpS) / riesgoS : na

puedeL = setupL and not na(tpL)
puedeS = setupS and not na(tpS)

// --- Estado de la posicion (para dibujar y etiquetar la salida) --------------------
var float entPrecio = na
var float entSL = na
var float entTP = na
var int entLado = 0
var line lnSL = na
var line lnTP = na
var string ultSenal = "Sin posicion"

f_fmt(float x) => str.tostring(x, "#.00")
f_hora() => str.format_time(time_close, "HH:mm", "America/New_York")

f_entrar(bool esLong, float sl, float tp, float rr, bool grande, bool alineado) =>
    float riesgo = math.abs(close - sl)
    float pct = grande ? riesgoGrande : riesgoChica
    int qty = math.max(1, int(math.floor(strategy.equity * pct / 100 / riesgo)))
    string lado = esLong ? "LONG" : "SHORT"
    string tam = grande ? "GRANDE" : "CHICA"
    string txt = lado + " · " + tam + " · " + f_hora() + "\n@ " + f_fmt(close) + "\nR:R 1:" + str.tostring(rr, "0.0") + "\nSL " + f_fmt(sl) + " · TP " + f_fmt(tp)
    strategy.entry(lado, esLong ? strategy.long : strategy.short, qty = qty, comment = lado + " " + tam + (alineado ? " AF" : " CT"))
    strategy.exit(lado + " salida", lado, stop = sl, limit = tp)
    color c = esLong ? color.new(#26a69a, 0) : color.new(#ef5350, 0)
    label.new(bar_index, esLong ? low : high, txt,
         style = esLong ? label.style_label_up : label.style_label_down,
         color = c, textcolor = color.white, size = size.small)
    alert("GGAL " + lado + " " + tam + " @ " + f_fmt(close) + " | SL " + f_fmt(sl) + " | TP " + f_fmt(tp) + " | R:R 1:" + str.tostring(rr, "0.0"), alert.freq_once_per_bar_close)
    txt

if strategy.position_size == 0 and enVentana and opsHoy < maxOps and barstate.isconfirmed
    if puedeL
        bool grande = not tendAlcista
        ultSenal := f_entrar(true, slL, tpL, rrL, grande, tendAlcista)
        entPrecio := close
        entSL := slL
        entTP := tpL
        entLado := 1
        opsHoy += 1
        lnSL := line.new(bar_index, slL, bar_index + 1, slL, color = color.new(#ef5350, 30), style = line.style_dashed)
        lnTP := line.new(bar_index, tpL, bar_index + 1, tpL, color = color.new(#26a69a, 30), style = line.style_dashed)
    else if puedeS
        bool grande = not tendBajista
        ultSenal := f_entrar(false, slS, tpS, rrS, grande, tendBajista)
        entPrecio := close
        entSL := slS
        entTP := tpS
        entLado := -1
        opsHoy += 1
        lnSL := line.new(bar_index, slS, bar_index + 1, slS, color = color.new(#ef5350, 30), style = line.style_dashed)
        lnTP := line.new(bar_index, tpS, bar_index + 1, tpS, color = color.new(#26a69a, 30), style = line.style_dashed)

// Mientras la posicion esta abierta, el stop y el objetivo se estiran vela a vela.
if strategy.position_size != 0 and not na(lnSL)
    line.set_x2(lnSL, bar_index)
    line.set_x2(lnTP, bar_index)

// Nada queda abierto de un dia para el otro.
if enCierre and strategy.position_size != 0
    strategy.close_all(comment = "Cierre de sesion", immediately = true)

// --- Etiqueta de salida -------------------------------------------------------------
if strategy.closedtrades > strategy.closedtrades[1]
    int i = strategy.closedtrades - 1
    float salida = strategy.closedtrades.exit_price(i)
    float riesgo = math.abs(entPrecio - entSL)
    float r = riesgo > 0 ? (salida - entPrecio) * entLado / riesgo : 0.0
    string motivo = math.abs(salida - entTP) <= syminfo.mintick * 2 ? "TP" : math.abs(salida - entSL) <= syminfo.mintick * 2 ? "SL" : "Cierre"
    // La cuenta de operaciones cerradas cambia en la vela SIGUIENTE a la salida (en
    // el cierre de sesion, la apertura del otro dia): la etiqueta va en la hora
    // real de salida.
    int tSalida = strategy.closedtrades.exit_time(i)
    string txt = motivo + " " + (r >= 0 ? "+" : "") + str.tostring(r, "0.0") + "R · " + str.format_time(tSalida, "HH:mm", "America/New_York")
    label.new(tSalida, salida, txt, xloc = xloc.bar_time,
         style = entLado == 1 ? label.style_label_down : label.style_label_up,
         color = color.new(r >= 0 ? #26a69a : #ef5350, 60), textcolor = color.white, size = size.tiny)
    alert("GGAL salida " + (entLado == 1 ? "LONG" : "SHORT") + ": " + txt + " @ " + f_fmt(salida), alert.freq_once_per_bar_close)
    ultSenal := "Sin posicion (ultima: " + txt + ")"
    entLado := 0
    lnSL := na
    lnTP := na

// --- Dibujo -----------------------------------------------------------------------------
plot(emaR, "EMA rapida", color = color.new(#2962ff, 40), linewidth = 1)
plot(emaL, "EMA lenta", color = color.new(#ff9800, 40), linewidth = 1)
plot(vwap, "VWAP", color = color.new(#9c27b0, 30), linewidth = 2)

// Se actualiza en cada vela: en una estrategia sin calc_on_every_tick,
// barstate.islast puede no dar true en vivo.
var table panel = table.new(position.top_right, 1, 2, bgcolor = color.new(#131722, 10), border_width = 1)
if barstate.isconfirmed
    string tend = tendAlcista ? "Tendencia diaria: ALCISTA" : tendBajista ? "Tendencia diaria: BAJISTA" : "Tendencia diaria: neutra"
    string pos = strategy.position_size > 0 ? "En posicion: " + ultSenal : strategy.position_size < 0 ? "En posicion: " + ultSenal : ultSenal
    table.cell(panel, 0, 0, tend, text_color = tendAlcista ? #26a69a : tendBajista ? #ef5350 : color.gray, text_size = size.small)
    table.cell(panel, 0, 1, pos, text_color = color.white, text_size = size.small)
