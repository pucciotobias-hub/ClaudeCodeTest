//@version=6
// GGAL Señales — postura en vivo sobre el ADR de GGAL (paper trading, 15m).
//
// En cada vela de 15 minutos dice que haria con plata real: LONG, SHORT o
// AFUERA, con tamaño (grande/chica), stop, objetivo y R:R. No opera nada.
//
// Postura:
//   - LONG: estructura intradia alcista = EMA9 sobre EMA21, cierre sobre el VWAP
//     y sobre la EMA9. SHORT: lo mismo al reves.
//   - Se sale de un LONG cuando la vela CIERRA debajo de la EMA21 (o toca stop u
//     objetivo); de un SHORT, cuando cierra arriba. Entrar pide mas que salir para
//     que la postura no se de vuelta a cada vela.
//   - AFUERA cuando no hay estructura, cuando el maximo/minimo de AYER tapa el
//     camino antes de 1,5R, o despues de un stop hasta que la estructura se de
//     vuelta (no reentra al mismo lado que acaba de fallar).
//   - Stop: extremo de las ultimas 5 velas con colchon de 0,1 ATR. Objetivo: el
//     primer nivel (maximo/minimo de ayer, de hoy o ultimo pivote) entre 1,5R y
//     4R; sin niveles a la vista, 2R.
//   - Entradas de 9:45 a 15:30 NY; todo cerrado en la vela de 15:45 NY.

strategy("GGAL Señales", shorttitle = "GGAL Señal", overlay = true,
     initial_capital = 100000, currency = currency.USD,
     commission_type = strategy.commission.cash_per_order, commission_value = 1,
     slippage = 1, pyramiding = 0,
     // Poder de compra intradia 4x (cuenta de day trading en EE.UU.). Con el
     // margen por defecto (100%) las posiciones grandes con stop corto piden mas
     // que el capital y TradingView rechaza la orden sin avisar.
     margin_long = 25, margin_short = 25,
     max_labels_count = 500, max_lines_count = 500)

// --- Parametros ----------------------------------------------------------------
emaRapLen    = input.int(9, "EMA rapida")
emaLenLen    = input.int(21, "EMA lenta")
atrLen       = input.int(14, "ATR")
rrMin        = input.float(1.5, "R:R minimo para entrar", step = 0.1)
rrMax        = input.float(4.0, "R:R maximo del objetivo", step = 0.1)
riesgoGrande = input.float(1.0, "Riesgo posicion grande (% del capital)", step = 0.1)
riesgoChica  = input.float(0.5, "Riesgo posicion chica (% del capital)", step = 0.1)
ventana      = input.session("0945-1530", "Ventana de entradas (hora NY)")
cierreSes    = input.session("1545-1600", "Cierre forzado: velas que arrancan en esta franja (hora NY)")

// --- Contexto diario (dia anterior: no repinta) --------------------------------
[dCierre, dEma, pdh, pdl] = request.security(syminfo.tickerid, "D",
     [close[1], ta.ema(close, 20)[1], high[1], low[1]], lookahead = barmerge.lookahead_on)
tendAlcista = dCierre > dEma
tendBajista = dCierre < dEma

// --- Intradiario ------------------------------------------------------------------
emaR = ta.ema(close, emaRapLen)
emaL = ta.ema(close, emaLenLen)
vwap = ta.vwap(hlc3)
atr  = ta.atr(atrLen)

enVentana = not na(time(timeframe.period, ventana, "America/New_York"))
enCierre  = not na(time(timeframe.period, cierreSes, "America/New_York"))
nuevoDia  = timeframe.change("D")

// Maximo y minimo de la sesion hasta la vela anterior.
var float hoyMax = na
var float hoyMin = na
float hoyMaxPrev = nuevoDia ? na : hoyMax
float hoyMinPrev = nuevoDia ? na : hoyMin
hoyMax := nuevoDia ? high : math.max(hoyMax, high)
hoyMin := nuevoDia ? low : math.min(hoyMin, low)

// Ultimos pivotes confirmados (5 velas a cada lado).
var float ultPH = na
var float ultPL = na
ph = ta.pivothigh(high, 5, 5)
pl = ta.pivotlow(low, 5, 5)
if not na(ph)
    ultPH := ph
if not na(pl)
    ultPL := pl

// --- Objetivo y camino ------------------------------------------------------------
// Devuelve el objetivo, o na si el maximo/minimo de AYER tapa el camino antes de
// rrMin. Los niveles intradia no bloquean: solo cuentan como objetivo.
f_objetivo(float entrada, float riesgo, bool esLong, array<float> bloqueantes, array<float> objetivos) =>
    bool tapado = false
    for n in bloqueantes
        if not na(n)
            float dist = esLong ? n - entrada : entrada - n
            if dist > 0 and dist < rrMin * riesgo
                tapado := true
    float obj = na
    for n in objetivos
        if not na(n)
            float dist = esLong ? n - entrada : entrada - n
            if dist >= rrMin * riesgo and dist <= rrMax * riesgo
                obj := na(obj) ? n : esLong ? math.min(obj, n) : math.max(obj, n)
    tapado ? na : na(obj) ? (esLong ? entrada + 2 * riesgo : entrada - 2 * riesgo) : obj

// --- Estructura ---------------------------------------------------------------------
estrL = emaR > emaL and close > vwap and close > emaR
estrS = emaR < emaL and close < vwap and close < emaR
rotaL = close < emaL   // un LONG se termina
rotaS = close > emaL   // un SHORT se termina

slL = ta.lowest(low, 5) - 0.1 * atr
slS = ta.highest(high, 5) + 0.1 * atr
riesgoL = close - slL
riesgoS = slS - close
tpL = riesgoL > 0 ? f_objetivo(close, riesgoL, true, array.from(pdh), array.from(pdh, hoyMaxPrev, ultPH)) : na
tpS = riesgoS > 0 ? f_objetivo(close, riesgoS, false, array.from(pdl), array.from(pdl, hoyMinPrev, ultPL)) : na
rrL = riesgoL > 0 ? (tpL - close) / riesgoL : na
rrS = riesgoS > 0 ? (close - tpS) / riesgoS : na

// --- Estado ---------------------------------------------------------------------------
var float entPrecio = na
var float entSL = na
var float entTP = na
var int entLado = 0
var string entTam = ""
var float entRR = na
var int entHora = na
var line lnSL = na
var line lnTP = na
var int bloqueo = 0        // lado que acaba de dar stop: no reentra hasta que la estructura se de vuelta
var string afuera = "AFUERA: arranca la rueda"

f_fmt(float x) => str.tostring(x, "#.00")
f_hhmm(int t) => str.format_time(t, "HH:mm", "America/New_York")

// 1) Salidas por stop u objetivo (se procesan antes de decidir la vela).
if strategy.closedtrades > strategy.closedtrades[1]
    int i = strategy.closedtrades - 1
    float salida = strategy.closedtrades.exit_price(i)
    int tSalida = strategy.closedtrades.exit_time(i)
    string com = strategy.closedtrades.exit_comment(i)
    float riesgo = math.abs(entPrecio - entSL)
    float r = riesgo > 0 ? (salida - entPrecio) * entLado / riesgo : 0.0
    string motivo = com != "" and not str.contains(com, "salida") ? com : math.abs(salida - entTP) <= syminfo.mintick * 2 ? "Objetivo" : "Stop"
    if motivo == "Stop"
        bloqueo := entLado
    string txt = "AFUERA · " + f_hhmm(tSalida) + "\n" + motivo + " " + (r >= 0 ? "+" : "") + str.tostring(r, "0.0") + "R"
    label.new(tSalida, salida, txt, xloc = xloc.bar_time,
         style = entLado == 1 ? label.style_label_down : label.style_label_up,
         color = color.new(r >= 0 ? #26a69a : #ef5350, 55), textcolor = color.white, size = size.small)
    afuera := "AFUERA desde " + f_hhmm(tSalida) + ": " + motivo + " " + (r >= 0 ? "+" : "") + str.tostring(r, "0.0") + "R"
    entLado := 0
    lnSL := na
    lnTP := na

// El bloqueo por stop se levanta cuando la estructura se da vuelta o arranca otro dia.
if nuevoDia or (bloqueo == 1 and estrS) or (bloqueo == -1 and estrL)
    bloqueo := 0

// 2) La estructura se rompio: se sale al cierre de la vela.
if barstate.isconfirmed and strategy.position_size > 0 and rotaL
    strategy.close("LONG", comment = "Perdio la EMA21", immediately = true)
if barstate.isconfirmed and strategy.position_size < 0 and rotaS
    strategy.close("SHORT", comment = "Recupero la EMA21", immediately = true)

// 3) Sin posicion: ¿entra?
f_entrar(bool esLong, float sl, float tp, float rr, bool grande, bool alineado) =>
    float riesgo = math.abs(close - sl)
    int qty = math.max(1, int(math.floor(strategy.equity * (grande ? riesgoGrande : riesgoChica) / 100 / riesgo)))
    string lado = esLong ? "LONG" : "SHORT"
    string tam = grande ? "GRANDE" : "CHICA"
    string txt = lado + " · " + tam + " · " + f_hhmm(time_close) + "\n@ " + f_fmt(close) + "\nR:R 1:" + str.tostring(rr, "0.0") + "\nSL " + f_fmt(sl) + " · TP " + f_fmt(tp)
    strategy.entry(lado, esLong ? strategy.long : strategy.short, qty = qty, comment = lado + " " + tam + (alineado ? " AF" : " CT"))
    strategy.exit(lado + " salida", lado, stop = sl, limit = tp)
    label.new(bar_index, esLong ? low : high, txt,
         style = esLong ? label.style_label_up : label.style_label_down,
         color = esLong ? #26a69a : #ef5350, textcolor = color.white, size = size.small)
    tam

if barstate.isconfirmed and strategy.position_size == 0 and entLado == 0
    if not enVentana
        afuera := enCierre or hour(time, "America/New_York") >= 15 ? "AFUERA: fin de la ventana de entradas" : "AFUERA: fuera de horario"
    else if estrL and bloqueo != 1
        if na(tpL)
            afuera := "AFUERA: alcista, pero el maximo de ayer (" + f_fmt(pdh) + ") tapa el camino"
        else
            bool grande = not tendAlcista
            entTam := f_entrar(true, slL, tpL, rrL, grande, tendAlcista)
            entPrecio := close
            entSL := slL
            entTP := tpL
            entRR := rrL
            entLado := 1
            entHora := time_close
            lnSL := line.new(bar_index, slL, bar_index + 1, slL, color = color.new(#ef5350, 30), style = line.style_dashed)
            lnTP := line.new(bar_index, tpL, bar_index + 1, tpL, color = color.new(#26a69a, 30), style = line.style_dashed)
    else if estrS and bloqueo != -1
        if na(tpS)
            afuera := "AFUERA: bajista, pero el minimo de ayer (" + f_fmt(pdl) + ") tapa el camino"
        else
            bool grande = not tendBajista
            entTam := f_entrar(false, slS, tpS, rrS, grande, tendBajista)
            entPrecio := close
            entSL := slS
            entTP := tpS
            entRR := rrS
            entLado := -1
            entHora := time_close
            lnSL := line.new(bar_index, slS, bar_index + 1, slS, color = color.new(#ef5350, 30), style = line.style_dashed)
            lnTP := line.new(bar_index, tpS, bar_index + 1, tpS, color = color.new(#26a69a, 30), style = line.style_dashed)
    else if bloqueo != 0
        afuera := "AFUERA: espera que la estructura se de vuelta despues del stop"
    else
        afuera := "AFUERA: sin estructura (EMAs y VWAP mezclados)"

// Mientras la posicion esta abierta, el stop y el objetivo se estiran vela a vela.
if entLado != 0 and not na(lnSL)
    line.set_x2(lnSL, bar_index)
    line.set_x2(lnTP, bar_index)

// Nada queda abierto de un dia para el otro.
if enCierre and strategy.position_size != 0
    strategy.close_all(comment = "Cierre de sesion", immediately = true)

// --- Dibujo -----------------------------------------------------------------------------
plot(emaR, "EMA rapida", color = color.new(#2962ff, 40), linewidth = 1)
plot(emaL, "EMA lenta", color = color.new(#ff9800, 40), linewidth = 1)
plot(vwap, "VWAP", color = color.new(#9c27b0, 30), linewidth = 2)
bgcolor(entLado == 1 ? color.new(#26a69a, 90) : entLado == -1 ? color.new(#ef5350, 90) : na, title = "Postura")
// La postura vigente como valores, para que el vigia la lea sin depender de las
// etiquetas (que cambian cada vez que el script se recalcula).
plot(entLado, "postura", display = display.data_window)
plot(entLado != 0 ? entHora : na, "p_hora", display = display.data_window)
plot(entLado != 0 ? entPrecio : na, "p_precio", display = display.data_window)
plot(entLado != 0 ? entSL : na, "p_sl", display = display.data_window)
plot(entLado != 0 ? entTP : na, "p_tp", display = display.data_window)
plot(entLado != 0 ? entRR : na, "p_rr", display = display.data_window)
plot(entLado != 0 ? (entTam == "GRANDE" ? 1 : 0) : na, "p_grande", display = display.data_window)

// Se actualiza en cada vela: en una estrategia sin calc_on_every_tick,
// barstate.islast puede no dar true en vivo.
var table panel = table.new(position.top_right, 1, 3, bgcolor = color.new(#131722, 10), border_width = 1)
if barstate.isconfirmed
    string ahora = entLado == 0 ? afuera :
         (entLado == 1 ? "LONG" : "SHORT") + " · " + entTam + " desde " + f_hhmm(entHora) + " @ " + f_fmt(entPrecio)
    string plan = entLado == 0 ? "" : "SL " + f_fmt(entSL) + " · TP " + f_fmt(entTP) + " · R:R 1:" + str.tostring(entRR, "0.0")
    string tend = tendAlcista ? "Tendencia diaria: ALCISTA" : tendBajista ? "Tendencia diaria: BAJISTA" : "Tendencia diaria: neutra"
    table.cell(panel, 0, 0, ahora, text_color = entLado == 1 ? #26a69a : entLado == -1 ? #ef5350 : color.gray, text_size = size.normal)
    table.cell(panel, 0, 1, plan, text_color = color.white, text_size = size.small)
    table.cell(panel, 0, 2, tend, text_color = color.gray, text_size = size.small)
