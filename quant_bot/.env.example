# Copia este archivo a .env y completa tus credenciales reales.
# El archivo .env NO debe subirse al repositorio.

# Token del bot (te lo da @BotFather en Telegram con /newbot)
TELEGRAM_BOT_TOKEN=123456789:AAExxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Tu chat id (visita https://api.telegram.org/bot<TOKEN>/getUpdates
# despues de escribirle al bot, y busca "chat":{"id": ...})
TELEGRAM_CHAT_ID=123456789
